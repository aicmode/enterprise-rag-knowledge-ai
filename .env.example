# =============================================================================
# Enterprise RAG Knowledge AI - environment template
# =============================================================================
# Copy to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed.
#
# Key separation, briefly:
#   NEXT_PUBLIC_*  -> inlined into the browser bundle. Public by definition.
#   everything else -> server only. Never prefix a secret with NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# -----------------------------------------------------------------------------
# Safe for the browser: the anon key can only do what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security entirely.
# Server-side only, used for reading uploaded PDFs back out of the private
# bucket and writing chunks after ownership has already been verified.
# Must never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# SECRET. Server-side only; the browser never calls OpenAI directly.
OPENAI_API_KEY=sk-your-openai-api-key

# Chat model used for answer generation. Swappable without a code change.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Vision-capable model used only when a PDF page has no usable native text.
# OCR is page-scoped and is never run for pages that pass native extraction.
OPENAI_OCR_MODEL=gpt-5-mini

# -----------------------------------------------------------------------------
# RAG tuning (all optional - defaults in src/lib/config/rag.ts)
# -----------------------------------------------------------------------------
# Number of chunks retrieved per question.
RAG_TOP_K=5

# Minimum cosine similarity (0..1) for a chunk to count as relevant.
# Raise it for fewer, more precise citations; lower it for better recall.
RAG_SIMILARITY_THRESHOLD=0.3

# Chunk size / overlap in characters. Overlap is clamped to at most half the
# chunk size so the chunker can always advance.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# -----------------------------------------------------------------------------
# NOTE: The embedding model is intentionally NOT configurable here.
# text-embedding-3-small produces 1536-dimensional vectors, which is hard-coded
# in the `vector(1536)` column. Changing the model requires a database
# migration, not an environment variable.
# -----------------------------------------------------------------------------
